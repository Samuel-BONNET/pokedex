generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model User {
  id            Int         @id @default(autoincrement())
  pseudo        String      @db.VarChar(50)
  email         String      @db.VarChar(50) @unique
  password      String
  role          String      @db.VarChar(50)
  isActive      Boolean     @default(true)
  preferences   Json        @db.JsonB
  createdAt     DateTime    @default(now())
  statuts       Statut[]
  gameSaves     GameSave[]
  pokemonPreferences PokemonPreferences[]
  gamePreferences   GamePreferences[]
}

model Game {
    id          Int         @id @default(autoincrement())
    nameEn      String      @db.VarChar(50) @unique
    generation  String
    gameSaves   GameSave[]
    gamePreferences GamePreferences[]
}

model GameSave {
    id          Int         @id @default(autoincrement())
    idGame      Int
    idUser      Int
    file        Bytes       @db.ByteA
    fileName    String
    size        Int
    updatedAt   DateTime    @updatedAt
    game        Game        @relation(fields: [idGame], references: [id])
    user        User        @relation(fields: [idUser], references: [id])
    @@unique([idGame, idUser])
}

model Pokemon {
    id              Int     @id @default(autoincrement())
    nameFr          String  @db.VarChar(50)
    nameEn          String  @db.VarChar(50)
    pokeNumber      Int     @unique
    availableGames  Json
    statuts         Statut[]
    pokemonPreferences PokemonPreferences[]
}

model Statut {
    idPokemon           Int
    idUser              Int

    user                User        @relation(fields: [idUser], references: [id])
    pokemon             Pokemon     @relation(fields: [idPokemon], references: [id])

    isOwned             Boolean
    isShiny             Boolean

    @@id([idPokemon, idUser])
}

model PokemonPreferences {
    idPokemon           Int
    idUser              Int

    pokemon             Pokemon    @relation(fields: [idPokemon], references: [id])
    user                User       @relation(fields: [idUser], references: [id])

    currentSprite       String

    @@id([idPokemon, idUser])
}

model GamePreferences {
    idGame              Int
    idUser              Int

    game              Game       @relation(fields: [idGame], references: [id])
    user              User       @relation(fields: [idUser], references: [id])


    currentSprite       String

    @@id([idGame, idUser])
}