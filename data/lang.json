        "positionRightImage": "left-20 sm:left-120 top-10"
      },
      "backgroundImage": false
    },
    "rouge": {
      "classes": {
        "mainBackground": "bg-red-300",
        "secondaryBackground": "bg-red-500",
        "color": "text-red-500",
        "border": "border-red-500",
        "hue": "hue-rotate-[140deg]",
        "themeClassesLogoImageSize": "size-50",
        "themeClassesRightImageSize": "size-85",
        "positionLogoImage": "left-12 sm:left-8 -top-11",
        "positionLeftImage": "left-20 sm:-left-27 -top-35",
        "positionRightImage": "left-15 sm:left-125 top-0"
      },
      "backgroundImage": false
    },
    "vert": {
      "classes": {
        "mainBackground": "bg-green-500",
        "secondaryBackground": "bg-green-600",
        "color": "text-green-500",
        "border": "border-green-500",
        "hue": "hue-rotate-[290deg]",
        "themeClassesLogoImageSize": "size-150",
        "themeClassesRightImageSize": "size-80",
        "positionLogoImage": "-left-2 sm:-left-8 -top-24",
        "positionLeftImage": "-left-2 sm:-left-8 -top-24",
        "positionRightImage": "left-20 sm:-left-27 -top-35"
      },
      "backgroundImage": false
    }
